rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /categories/{id} {
      allow read: if resource.data.isActive == true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if resource.data.isActive == true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.status == "active";
      allow write: if isAdmin();

      match /variants/{variantId} {
        allow read: if get(/databases/$(database)/documents/products/$(productId)).data.status == "active";
        allow write: if isAdmin();
      }
    }

    match /newsletter/{id} {
      allow create: if request.resource.data.keys().hasOnly(["email", "createdAt"])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320;
      allow read, update, delete: if isAdmin();
    }
  }
}
