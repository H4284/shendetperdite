# --- Local emulator (npm run dev + npm run dev:emulators) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-shendetperdite.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-shendetperdite
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-shendetperdite.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

FIREBASE_PROJECT_ID=demo-shendetperdite
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Used by the Admin SDK and npm run seed against local emulators.
# Do NOT add these three to Vercel.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Production (Vercel + npm run seed:prod) ---
# Create the web app in Firebase Console for project shendetperdite-8d758,
# then set these on Vercel as Config (NEXT_PUBLIC_*) or Secret (ADMIN_*).
# Never set FIRESTORE_EMULATOR_HOST on Vercel.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=shendetperdite-8d758
# FIREBASE_PROJECT_ID=shendetperdite-8d758
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...@shendetperdite-8d758.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
